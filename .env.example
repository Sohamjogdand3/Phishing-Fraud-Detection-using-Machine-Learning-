# ==============================================================================
# Phishing URL Detection Website - Environment Configuration Template
# Copy this file to .env in production and replace placeholder values.
# ==============================================================================

# Application Security
FLASK_SECRET_KEY=change-this-to-a-cryptographically-secure-random-key-64-chars
OTP_SECRET_SALT=change-this-to-a-secure-random-otp-salt-hex-string
PORT=5000

# SQLite Database Location (defaults to phishing_app.db in project root)
DATABASE_PATH=phishing_app.db

# Administrative Access (Legacy credentials fallback)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_admin_password_in_production

# ==============================================================================
# Email & SMTP Delivery Settings
# (If MAIL_SERVER is unset, system runs in dev mode: OTPs logged to console/memory)
# ==============================================================================
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-specific-password
MAIL_DEFAULT_SENDER="PhisGuard" <noreply@yourdomain.com>
